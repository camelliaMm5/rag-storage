# ============================================================
#  环境变量模板
#  用法：copy .env.example .env 然后按需填写
#  注意：.env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库
# ============================================================

# ── Embedding / RAG ─────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=faq_knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DOCS_DIR=./docs

# HuggingFace 离线模式（避免首次启动联网超时；模型已缓存后可开启）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── LLM ─────────────────────────────────────────────────────
# 留空 → 应用进入降级模式：聊天返回友好提示而非 500，其余功能正常
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 会话数据库（PostgreSQL）─────────────────────────────────
CONVERSATION_DB_URL=postgresql://user:1234@localhost:5432/agent
CONVERSATION_MAX_CONTEXT_TURNS=5

# 电商库（默认回落到 CONVERSATION_DB_URL）
SHOP_DB_URL=
# 连接池容量：maxconn 故意小于线程池上限，让「池耗尽」成为背压而非打爆数据库
SHOP_DB_POOL_MIN=2
SHOP_DB_POOL_MAX=10
# 慢查询 / 锁等待兜底（毫秒）。与 TOOL_TIMEOUT_SEC 形成双保险：
# 应用侧快速失败 + 数据库侧真正掐断查询并释放连接
SHOP_DB_STATEMENT_TIMEOUT_MS=5000
SHOP_DB_IDLE_TX_TIMEOUT_MS=30000

# 单次工具调用对外超时（秒）
TOOL_TIMEOUT_SEC=8

# ── 运行环境与演示开关 ──────────────────────────────────────
# production 下：默认密钥直接拒绝启动；/api/token 与默认内部 token 自动关闭
APP_ENV=development

# ⚠️ /api/token 是「无凭证签发任意 user_id 身份」的 demo 入口，会绕过全部 IDOR 校验。
# 默认：非 production 开启。生产请保持关闭（设 0 或 APP_ENV=production）。
ALLOW_DEMO_TOKEN=1

# 内部接口（/internal/*，可读全量订单/用户）的令牌。生产必须替换为随机长串。
INTERNAL_API_TOKEN=dev-internal-token

# ── JWT 认证 ────────────────────────────────────────────────
# 生产环境务必替换为随机长密钥
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LangGraph Checkpointer 持久化 ───────────────────────────
CHECKPOINT_DB_PATH=./checkpoints.db

# ── Redis 缓存（Cache-Aside）────────────────────────────────
# Redis 不可用时自动熔断并降级为直查，不影响服务可用性
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=1
CACHE_TTL_FAQ=600
CACHE_TTL_PRODUCT=300
CACHE_TTL_CATEGORY=600

# ── 超时订单自动取消 ────────────────────────────────────────
ORDER_TIMEOUT_MINUTES=30
ORDER_SWEEP_INTERVAL_SEC=300
